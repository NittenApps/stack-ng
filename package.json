{
  "name": "stack",
  "version": "21.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "tsx ./build/pre-build.ts && tsx ./build/build.ts",
    "link": "npm run build && tsx ./build/link.ts",
    "publish": "npm run build && tsx ./build/publish.ts",
    "test:forms": "jest --config ./jest.forms.config.js --coverage",
    "test:forms-watch": "jest --config ./jest.forms.config.js --watch",
    "unlink": "tsx ./build/unlink.ts",
    "watch": "ng build --watch --configuration development"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.2",
    "@angular/cdk": "^21.2.2",
    "@angular/common": "^21.2.2",
    "@angular/compiler": "^21.2.2",
    "@angular/core": "^21.2.2",
    "@angular/forms": "^21.2.2",
    "@angular/google-maps": "^21.0.0",
    "@angular/material": "^21.2.2",
    "@angular/material-moment-adapter": "^21.2.2",
    "@angular/platform-browser": "^21.2.2",
    "@angular/platform-browser-dynamic": "^21.2.2",
    "@angular/router": "^21.2.2",
    "@angular/service-worker": "^21.2.2",
    "@fortawesome/angular-fontawesome": "^4.0.0",
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/pro-duotone-svg-icons": "^7.0.0",
    "@fortawesome/pro-solid-svg-icons": "^7.0.0",
    "@mat-datetimepicker/core": "^17.0.0",
    "@mat-datetimepicker/moment": "^17.0.0",
    "bootstrap": "^5.3.3",
    "keycloak-angular": "^21.0.0",
    "keycloak-js": "26.2.3",
    "ngx-mask": "^21.0.0",
    "ngx-quill": "^30.0.0",
    "primeng": "^21.0.0",
    "quill": "2.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.2",
    "@angular/cli": "^21.2.2",
    "@angular/compiler-cli": "^21.2.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.17.6",
    "autoprefixer": "^10.4.19",
    "jest": "^30.3.0",
    "jest-extended": "^7.0.0",
    "jest-preset-angular": "^16.0.0",
    "json-schema": "^0.4.0",
    "ng-packagr": "^21.2.0",
    "postcss": "^8.4.38",
