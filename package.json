{
  "name": "stack",
  "version": "20.0.0-next.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "tsx ./build/pre-build.ts && tsx ./build/build.ts",
    "link": "npm run build && tsx ./build/link.ts",
    "publish": "npm run build && tsx ./build/publish.ts",
    "test:forms": "jest --config ./jest.forms.config.js --coverage",
    "test:forms-watch": "jest --config ./jest.forms.config.js --watch",
    "unlink": "tsx ./build/unlink.ts",
    "watch": "ng build --watch --configuration development"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.15",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.15",
    "@angular/compiler": "^20.3.15",
    "@angular/core": "^20.3.15",
    "@angular/forms": "^20.3.15",
    "@angular/google-maps": "^20.0.0",
    "@angular/material": "^20.2.14",
    "@angular/material-moment-adapter": "^20.2.14",
    "@angular/platform-browser": "^20.3.15",
    "@angular/platform-browser-dynamic": "^20.3.15",
    "@angular/router": "^20.3.15",
    "@angular/service-worker": "^20.3.15",
    "@fortawesome/angular-fontawesome": "^3.0.0",
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/pro-duotone-svg-icons": "^7.0.0",
    "@fortawesome/pro-solid-svg-icons": "^7.0.0",
    "@mat-datetimepicker/core": "^16.0.0",
    "@mat-datetimepicker/moment": "^16.0.0",
    "bootstrap": "^5.3.3",
    "keycloak-angular": "^20.0.0",
    "keycloak-js": "26.0.5",
    "ngx-mask": "^20.0.0",
    "ngx-quill": "^28.0.0",
    "primeng": "^20.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.13",
    "@angular/cli": "^20.3.13",
    "@angular/compiler-cli": "^20.3.15",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.17.6",
    "autoprefixer": "^10.4.19",
    "jest": "^29.7.0",
    "jest-extended": "^4.0.2",
    "jest-preset-angular": "^14.1.1",
    "json-schema": "^0.4.0",
    "ng-packagr": "^20.3.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.1.18",
    "ts-jest": "^29.2.1",
    "tsx": "^4.16.2",
    "typescript": "~5.9.3"
  },
  "packageManager": "npm@10.9.4"
}
